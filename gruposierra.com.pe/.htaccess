# =========================================================================
# GRUPO SIERRA — Configuración Apache / cPanel (.htaccess)
# URLs Limpias, Seguridad y Optimización de Rendimiento
# =========================================================================

# 1. Página de inicio por defecto
DirectoryIndex index.html index.php

# 2. Desactivar listado de directorios
Options -Indexes

# 3. Motor de reescritura de URLs limpias (Sin .html)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirigir /index.html a la raíz / (301 Permanente)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*index\.html\ HTTP/ [NC]
    RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

    # Redirigir cualquier archivo .html a su versión limpia sin extensión
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/ [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Resolver internamente URLs sin extensión al archivo .html real
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 4. Compresión Gzip para carga ultrarrápida
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 5. Cabeceras de Seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header set Access-Control-Allow-Origin "*"
</IfModule>
